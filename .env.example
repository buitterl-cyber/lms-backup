# Copy to .env and fill. Local defaults match docker-compose.yml ports.
DATABASE_URL="postgresql://riyada:riyada@localhost:5440/riyada?schema=public"
REDIS_URL="redis://localhost:6390"
MEILI_HOST="http://localhost:7700"
MEILI_MASTER_KEY="devmasterkey"
RABBITMQ_URL="amqp://localhost:5672"
CLICKHOUSE_URL="http://localhost:8123"

# Keycloak (OIDC)
KEYCLOAK_URL="http://localhost:8080"
KEYCLOAK_REALM="riyada"
KEYCLOAK_CLIENT_ID="riyada-api"
KEYCLOAK_CLIENT_SECRET=""

# Storage
S3_ENDPOINT=""
S3_BUCKET="riyada-content"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# AI — LLM router (provider-neutral). Default reasoning model: Anthropic Claude.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""
LOCAL_LLM_BASE_URL=""

# Encryption key for provider credentials at rest (KMS in prod)
CREDENTIALS_ENC_KEY=""

# GO1 (content-provider integration) — placeholders until we receive real sandbox/production
# credentials + API docs from Luke Barnes at GO1. Normal per-tenant client id/secret are entered
# via the admin Providers page and stored encrypted (ProviderConnection.credentialsEnc); the vars
# below are optional platform-level fallbacks/overrides — see
# packages/providers/src/providers/go1.provider.ts and
# apps/api/src/modules/providers/provider-webhooks.controller.ts for how each is consumed.
GO1_API_BASE_URL="https://api.go1.com"
GO1_OAUTH_TOKEN_URL=""
GO1_CLIENT_ID=""
GO1_CLIENT_SECRET=""
GO1_WEBHOOK_SECRET=""
# Unconfirmed whether GO1 pushes completions via webhook or requires polling (or both) — flip
# this to "true" only once that's settled with GO1; see jobs/jobs.service.ts providerProgressPoll().
PROVIDER_POLLING_ENABLED="false"
